# Единственная публичная точка системы. Отдаёт статику Mini App и проксирует
# её запросы в checks-service. Оба с одного имени намеренно: один origin — ни
# CORS, ни mixed content, ни отдельного хостинга под страницу.
#
# Имя через sslip.io разрешается в записанный в нём же адрес, поэтому домен
# покупать не нужно, а Let's Encrypt выдаёт на него обычный сертификат. Telegram
# открывает Mini App только по HTTPS, так что сертификат тут не украшение.
#
# api и Postgres сюда не выведены и остаются на 127.0.0.1: наружу смотрит ровно
# один сервис, и он единственный, у кого есть проверка подписи.
185.239.49.175.sslip.io {
    handle /api/* {
        reverse_proxy checks-service:8000
    }

    handle {
        root * /srv/mini_app
        file_server
    }
}
