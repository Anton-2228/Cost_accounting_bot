# Переменные, которые docker compose подставляет в сам compose-файл (в отличие
# от env/*.env, которые попадают внутрь контейнеров). Читается только файл с
# именем `.env` в корне репозитория.
#
# Файл НЕОБЯЗАТЕЛЕН: у всех переменных в docker-compose.yml есть значения по
# умолчанию — те, что действуют на текущем сервере. Заводить `.env` нужно при
# развёртывании на другой машине, чтобы Grafana открывалась по её адресу.
#
#   cp .env.example .env
#
# После правки — `docker compose up -d`: сертификат перевыпустится сам, потому
# что изменится GRAFANA_TLS_SAN.

# Имя, по которому в Grafana заходят снаружи. Идёт в server_name, в CN
# сертификата и в GF_SERVER_ROOT_URL — из последнего Grafana строит ссылки в
# уведомлениях и в кнопке «поделиться».
GRAFANA_PUBLIC_HOST=root-hub.ru

# Внешний порт. Внутри контейнера nginx слушает 41142 всегда; здесь задаётся
# только то, что публикуется наружу.
GRAFANA_PUBLIC_PORT=41142

# Адрес, на котором публиковать. 0.0.0.0 — вход открыт из интернета (при
# соответствующем пробросе на шлюзе). Поставьте 127.0.0.1, чтобы поднять стек
# без публичного входа — например на машине разработчика.
GRAFANA_PUBLIC_BIND=0.0.0.0

# Имена и адреса в сертификате. Нужны ОБА вида: снаружи в Grafana приходят по
# имени, из локальной сети — по адресу хоста. Формат — как у openssl:
# DNS:<имя>, IP:<адрес>, через запятую, без пробелов.
GRAFANA_TLS_SAN=DNS:root-hub.ru,IP:192.168.100.114,IP:95.31.139.53
