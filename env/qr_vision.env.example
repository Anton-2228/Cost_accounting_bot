# Сайдкар фолбека QR (qr_vision). Зовётся из checks_service, только когда
# zxing не прочитал QR на фото чека.

# Ключ OpenRouter. Есть только у этого контейнера: наружу его порт не выведен.
# Заведите ОТДЕЛЬНЫЙ ключ с лимитом расходов: у агента полный bash, фото — чужой
# ввод, и ключ из окружения его командам доступен. Лимит — потолок ущерба.
OPENROUTER_API_KEY=
# Модель OpenRouter. Должна понимать изображения и быть в каталоге pi.
QR_VISION_MODEL=anthropic/claude-opus-5.5
# Сколько даётся агенту на одно фото, мс (вместе с ожиданием в очереди).
# Меньше таймаута checks_service (120 с).
QR_VISION_TIMEOUT_MS=110000
