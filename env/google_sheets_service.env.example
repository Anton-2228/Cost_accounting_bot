# Адрес основного api. В docker compose значение переопределяется блоком
# environment, поэтому здесь оно важно только для запуска вне Compose.
API_BASE_URL=http://localhost:8010/api/v1
API_TIMEOUT_SECONDS=30

# Учётные данные сервисного аккаунта Google — один из двух способов.
# В Compose ключ монтируется файлом, поэтому обычно нужен только путь.
GOOGLE_CREDENTIALS_PATH=/run/secrets/google_sa.json
# GOOGLE_CREDENTIALS_JSON=

# Явный таймаут сокета. Без него googleapiclient ставит неявную минуту, и на
# протухшем keep-alive соединении проход висит всю её.
GOOGLE_TIMEOUT_SECONDS=20
GOOGLE_MAX_RETRIES=5

# Цикл. Пауза стоит между задачами: квота Google — 60 запросов в минуту на
# проект, и пачка задач подряд выжгла бы её целиком.
CLAIM_LIMIT=20
TICK_INTERVAL_SECONDS=5
TICK_JITTER_SECONDS=1
INITIAL_DELAY_SECONDS=5

DEBUG=False
LOG_LEVEL=INFO
