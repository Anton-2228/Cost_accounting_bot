# Вход в Grafana.
#
# ПУСТОЙ ПАРОЛЬ ОСТАВЛЯЕТ admin/admin. За этим входом видно, кто и когда
# сканировал чеки, QR-строка целиком, ссылка на чек на сайте налоговой и каждая
# покупка с ценой — то есть заметно больше, чем видно в логах.
#
# ЭТОТ ПАРОЛЬ — ЕДИНСТВЕННАЯ ЗАЩИТА ПУБЛИЧНОГО ВХОДА. Grafana выведена в
# интернет на https://root-hub.ru:41142 (deploy/nginx/grafana.conf.example), и
# ограничений по адресу источника там нет: форму входа видит кто угодно. В
# отличие от Mini App проверять здесь нечего — ни подписи, ни второго фактора.
# Пустой или словарный пароль означает чужие покупки в открытом доступе, а не
# «доступно тому, у кого есть доступ к машине». Ставить длинный случайный.
#
# Пароль ПЕРЕПРИМЕНЯЕТСЯ ИЗ ЭТОГО ФАЙЛА ПРИ КАЖДОМ СТАРТЕ контейнера: смена его
# в интерфейсе живёт до ближайшего перезапуска. Менять — здесь, затем
# `docker compose up -d grafana`.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Подключение к Postgres от имени роли только на чтение. Значения подставляются
# в deploy/grafana/provisioning/datasources/datasources.yml, поэтому пароль не
# лежит в репозитории.
#
# GRAFANA_DB_NAME должен совпадать с POSTGRES_DB в postgres.env и api.env,
# GRAFANA_DB_PASSWORD — с GRAFANA_DB_PASSWORD в postgres.env (там роль
# заводится, здесь используется).
GRAFANA_DB_NAME=cost
GRAFANA_DB_PASSWORD=
