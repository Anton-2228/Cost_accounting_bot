# Токен бота от @BotFather. Сервис не отправляет сообщений — этим же токеном
# Telegram подписывает initData, и без него подпись не проверить.
TELEGRAM_BOT_TOKEN=

# Кому разрешено добавлять чеки: telegram_id через запятую. Тот же список, что
# у бота. ПУСТОЕ ЗНАЧЕНИЕ ОЗНАЧАЕТ «НИКОМУ»: расшифровка чека платная и
# лимитированная, и открытый сервис позволил бы сжечь лимит чужими руками.
ALLOWED_TELEGRAM_IDS=

# Адрес основного api. В docker compose значение переопределяется блоком
# environment, поэтому здесь оно важно только для запуска вне Compose.
API_BASE_URL=http://localhost:8010/api/v1
API_TIMEOUT_SECONDS=30

# Внешняя расшифровка российских чеков.
PROVERKACHEKA_BASE_URL=https://proverkacheka.com/api/v1/check/get
PROVERKACHEKA_API_TOKEN=
# Явный таймаут. Старая версия звала proverkacheka без таймаута прямо из
# асинхронного кода, и зависший сервис останавливал весь бот.
PROVERKACHEKA_TIMEOUT_SECONDS=20

# Возраст initData, после которого она считается протухшей (секунды). Подпись
# бессрочна сама по себе, поэтому без ограничения перехваченная строка работала
# бы вечно.
INIT_DATA_MAX_AGE_SECONDS=86400

DEBUG=False
LOG_LEVEL=INFO
