# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Адрес основного api. В docker compose значение переопределяется блоком
# environment, поэтому здесь оно важно только для запуска вне Compose.
API_BASE_URL=http://localhost:8010/api/v1
API_TIMEOUT_SECONDS=60

# Хранилище состояний диалогов. В Compose хост переопределяется на `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Кому разрешено пользоваться ботом: telegram_id через запятую.
# ПУСТОЕ ЗНАЧЕНИЕ ОЗНАЧАЕТ «НИКОМУ». Это не перестраховка: /start заводит
# документ в Google на общий сервисный аккаунт с квотой 60 запросов в минуту на
# весь проект, и открытый бот позволил бы исчерпать её чужими руками.
ALLOWED_TELEGRAM_IDS=

# Порт, на котором бот принимает уведомления от api (POST /notify).
# Наружу не публикуется.
NOTIFY_PORT=8002

# Прокси для обращений к Telegram Bot API. Пусто — напрямую. Поддерживаются
# схемы socks5://, socks4://, http:// (при необходимости с логином:
# socks5://user:pass@host:port).
#
# Касается ТОЛЬКО Telegram: к api учёта бот ходит по внутренней сети Compose,
# и заворачивать этот трафик в прокси значило бы ломать рабочее соединение.
# Провайдер модели задаётся своим OPENAI_BASE_URL.
TELEGRAM_PROXY_URL=

# Модель для разбора чека: она подсказывает типы товаров и категории для новых
# типов. Без ключа команда /check работать не будет — других способов получить
# подсказки у бота нет. Ни драйвера БД, ни ключей Google у бота по-прежнему нет:
# это его единственная внешняя зависимость помимо api и Telegram.
OPENAI_API_KEY=
# Идентификатор модели зависит от провайдера: у официального OpenAI это
# «gpt-4o-mini», у OpenRouter — с префиксом, «openai/gpt-4o-mini» или
# «anthropic/claude-sonnet-4.5». Перепутать значит получать ошибку на каждый
# вызов и «Подсказки недоступны» на каждый чек.
#
# Модель обязана поддерживать `response_format: json_object`: разбор проверяет
# ответ схемой, и без гарантии JSON каждый второй чек упирался бы в
# `AiResponseError`. У OpenRouter это видно в `supported_parameters` модели.
#
# Версию стоит закреплять: плавающий алиас («…-latest») менял бы поведение
# разбора без единой правки в конфиге.
OPENAI_MODEL=anthropic/claude-sonnet-4.5
# Пусто — официальный адрес OpenAI. Значение нужно для совместимых провайдеров.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=60
# Задача классифицирующая, а не творческая: разброс ответов тут только вредит.
AI_TEMPERATURE=0.2

LOG_LEVEL=INFO
