# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Адрес основного api. В docker compose значение переопределяется блоком
# environment, поэтому здесь оно важно только для запуска вне Compose.
API_BASE_URL=http://localhost:8010/api/v1
API_TIMEOUT_SECONDS=60

# Хранилище состояний диалогов. В Compose хост переопределяется на `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Кому разрешено пользоваться ботом: telegram_id через запятую.
# ПУСТОЕ ЗНАЧЕНИЕ ОЗНАЧАЕТ «НИКОМУ». Это не перестраховка: /start заводит
# документ в Google на общий сервисный аккаунт с квотой 60 запросов в минуту на
# весь проект, и открытый бот позволил бы исчерпать её чужими руками.
ALLOWED_TELEGRAM_IDS=

# Порт, на котором бот принимает уведомления от api (POST /notify).
# Наружу не публикуется.
NOTIFY_PORT=8002

LOG_LEVEL=INFO
