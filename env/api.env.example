# Подключение к Postgres. В docker compose эти значения переопределяются
# блоком environment, поэтому здесь они важны только для запуска вне Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cost
POSTGRES_PASSWORD=
POSTGRES_DB=cost

# Поведение приложения. Значения по умолчанию живут в api/core/constants.py,
# здесь их дублировать не нужно.
APP_NAME=Cost Accounting API
DEBUG=False
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Адрес, по которому бот принимает уведомления. Пустое значение выключает
# рассылку: сообщения продолжат копиться в user_notifications, но никуда не
# уйдут. В docker compose значение задаётся блоком environment.
BOT_NOTIFY_URL=
NOTIFICATION_PUSH_INTERVAL_SECONDS=15
NOTIFICATION_PUSH_TIMEOUT_SECONDS=10
