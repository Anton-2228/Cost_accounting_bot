# Должны совпадать с POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB в api.env.
POSTGRES_USER=cost
POSTGRES_PASSWORD=
POSTGRES_DB=cost

# Пароль роли grafana_ro — той, от имени которой Grafana читает чеки и товары.
# Должен совпадать с GRAFANA_DB_PASSWORD в grafana.env: здесь он ЗАДАЁТСЯ (роль
# заводит deploy/postgres/10-grafana-readonly.sh), там ИСПОЛЬЗУЕТСЯ.
#
# Роль не совпадает с POSTGRES_USER намеренно: у неё есть SELECT по четырём
# таблицам и ничего больше, поэтому Grafana физически не может испортить данные,
# а её компрометация не откроет ни llm_usages, ни spreadsheet_accesses.
GRAFANA_DB_PASSWORD=
