# Вторая публичная точка системы: Grafana на https://root-hub.ru:41142.
#
# Шаблон, а не готовый конфиг: образ nginx сам прогоняет файлы из
# /etc/nginx/templates через envsubst и кладёт результат в conf.d при старте
# контейнера. Подставляются ТОЛЬКО переменные, объявленные в окружении
# контейнера, поэтому $host, $scheme и прочие переменные nginx остаются как
# есть — это штатное поведение образа, а не совпадение.
#
# Отсюда и переносимость: адрес, порт и имена в сертификате задаются в .env в
# корне репозитория, и развёртывание на другом сервере не требует править ни
# одного файла конфигурации.
#
# До появления этого файла Grafana не выводилась наружу вовсе и смотрелась через
# SSH-туннель. Теперь она открыта из интернета, и это осознанный размен, а не
# побочный эффект: за формой входа видно QR-строку каждого чека, ссылку на него
# на сайте налоговой и каждую покупку с ценой. У Mini App снаружи есть проверка
# подписи initData, здесь такой проверки нет и быть не может — единственная
# защита — пароль из env/grafana.env. Пустой или слабый пароль здесь означает
# чужие покупки в открытом доступе.
#
# TLS ТЕРМИНИРУЕТСЯ ЗДЕСЬ — и этим раскладка отличается от Mini App, где его
# снимает шлюз. Причина в способе публикации: Proxmox пробрасывает 41142
# порт-в-порт (DNAT), то есть шифрованное соединение идёт насквозь до этой
# машины, и расшифровать его больше негде. Сертификат выпускает сервис
# grafana-tls-init (deploy/tls/10-grafana-cert.sh) в общий том.
#
# HSTS ЗДЕСЬ НЕТ НАМЕРЕННО. Заголовок Strict-Transport-Security с
# самоподписанным сертификатом убирает из Chrome саму кнопку «Перейти всё
# равно»: вход станет недоступен, и починить это из браузера будет нечем.
# Добавлять его можно только вместе с сертификатом от публичного CA.
#
# Mini App этот контейнер не обслуживает и обслуживать не должен: он остаётся на
# nginx хоста (deploy/nginx/mini_app.conf.example), на 80-м порту и за шлюзом,
# терминирующим TLS. Свести их в один nginx значило бы поставить содержимое
# чеков на то же имя и тот же порт, что и публичную страницу.

# Зона под ограничение входа. Объявлена в http-контексте — conf.d включается
# именно туда, поэтому директива стоит вне server-блока.
#
# 10 попыток в минуту с адреса: живому человеку, промахнувшемуся паролем,
# этого не заметить, а перебор по словарю становится бессмысленным.
#
# Ключ — $binary_remote_addr, реальный адрес клиента: и DNAT на Proxmox, и
# публикация порта docker-ом адрес отправителя не подменяют. ПОДСТАВЛЯТЬ СЮДА
# X-Forwarded-For НЕЛЬЗЯ — доверенного прокси перед этим nginx нет, заголовок
# пришёл бы прямо от клиента, и подделать его мог бы кто угодно.
limit_req_zone $binary_remote_addr zone=grafana_login:1m rate=10r/m;

server {
    listen 41142 ssl;
    listen [::]:41142 ssl;

    # Порт внутри контейнера фиксирован; наружу его отображает compose, и только
    # там он настраивается (GRAFANA_PUBLIC_PORT). Имя нужно не для выбора блока
    # — на этом порту он единственный, — а чтобы Grafana видела в Host тот же
    # адрес, что набрал человек.
    server_name ${GRAFANA_PUBLIC_HOST} _;

    # http2 не включён сознательно: до nginx 1.25 это `listen ... ssl http2`,
    # после — отдельная директива, и неверный для версии вариант роняет запуск.
    # Grafana работает и без него.
    ssl_certificate     /etc/ssl/grafana/grafana.crt;
    ssl_certificate_key /etc/ssl/grafana/grafana.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:grafana:1m;

    # Дашборды отдают таблицы позиций целиком, и ответ бывает крупным; заодно
    # это потолок для импорта дашборда через интерфейс.
    client_max_body_size 10m;

    # Форма входа — единственное место, где пароль можно подобрать, поэтому
    # ограничение висит ровно на ней. Точное совпадение (`= /login`), чтобы под
    # лимит не попали дашборды: их листают быстро и помногу.
    #
    # burst=10 nodelay: подряд идущие попытки сверх лимита получают 503, но
    # небольшой всплеск (перезагрузка страницы, автозаполнение) проходит без
    # задержки.
    location = /login {
        limit_req zone=grafana_login burst=10 nodelay;

        proxy_pass http://grafana:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana Live: панели обновляются по WebSocket. Без Upgrade/Connection
    # nginx закрывает соединение как обычный HTTP-запрос, и это читается не как
    # ошибка, а как «дашборд почему-то не живой».
    location /api/live/ {
        proxy_pass http://grafana:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Всё остальное. Адресат — имя сервиса в docker-сети, а не 127.0.0.1:
    # публикация Grafana на loopback хоста остаётся только для SSH-туннеля, и
    # выключить её можно, не тронув этот файл.
    #
    # В proxy_pass намеренно нет пути после порта — так nginx передаёт URI
    # неизменным. Слэш в конце обрезал бы префикс и сломал бы вложенные пути.
    #
    # X-Forwarded-Proto здесь $scheme, а не константа: TLS снимается прямо тут,
    # и переменная говорит правду сама. По этому заголовку Grafana решает, можно
    # ли выставить куку с флагом Secure, — без него вход зациклился бы на форме
    # логина при включённом GF_SECURITY_COOKIE_SECURE.
    location / {
        proxy_pass http://grafana:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Тяжёлый SQL-запрос по позициям чеков за большой период не должен
        # обрываться раньше, чем Grafana успеет ответить.
        proxy_read_timeout 120s;
    }
}
