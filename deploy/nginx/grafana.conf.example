# Вторая публичная точка системы: Grafana на https://root-hub.ru:41142.
#
# До этого файла Grafana не выводилась наружу вовсе и смотрелась через
# SSH-туннель. Теперь она открыта из интернета, и это осознанный размен, а не
# побочный эффект: за формой входа видно QR-строку каждого чека, ссылку на него
# на сайте налоговой и каждую покупку с ценой. У Mini App снаружи есть проверка
# подписи initData, здесь такой проверки нет и быть не может — единственная
# защита — пароль из env/grafana.env. Пустой или слабый пароль здесь означает
# чужие покупки в открытом доступе, см. README, раздел «Публикация Grafana».
#
# TLS терминирует шлюз (95.31.139.53) — ровно как у Mini App, тем же принципом и
# его собственным сертификатом Let's Encrypt на root-hub.ru. Сюда, на
# 192.168.100.114:41142, приходит уже расшифрованный HTTP, поэтому в этом файле
# нет ни сертификата, ни ключа, ни редиректа: снаружи HTTPS обеспечен шлюзом.
# Если TLS однажды переедет на этот хост — добавить `listen 41142 ssl` и пару
# ssl_certificate, а X-Forwarded-Proto ниже переключить на $scheme.
#
# Отсюда же требование к шлюзу: 41142 он должен обслуживать как HTTP-прокси
# (терминировать TLS и проксировать на этот хост), а не пробрасывать TCP —
# расшифровывать здесь нечем.
#
# HSTS — дело шлюза, а не этого файла: заголовок имеет смысл только там, где
# живёт TLS.
#
# Вход ТОЛЬКО СНАРУЖИ, по имени. Из локальной сети по http://192.168.100.114:41142
# войти нельзя, и это следствие, а не недоделка: у Grafana включён
# GF_SECURITY_COOKIE_SECURE, а куку с флагом Secure браузер не отдаёт обратно по
# незашифрованному соединению — вход зациклился бы на форме логина. Имя изнутри
# сети тоже не спасает: оно ведёт на шлюз и без NAT loopback не возвращается.
# Из локальной сети и с самой машины смотреть через SSH-туннель на 3000, см.
# README, раздел «Наблюдение».
#
# Отдельный файл, а не второй server-блок в mini_app.conf: у Mini App и Grafana
# разные порты и разная судьба — любую из двух публикаций надо уметь выключить
# одним symlink, не трогая вторую.
#
# Grafana остаётся опубликованной compose-ом только на 127.0.0.1:3000. Этот
# файл — единственный путь к ней снаружи, поэтому ограничение частоты попыток
# входа стоит именно здесь: своей защиты от подбора пароля у Grafana нет.
#
# Установка:
#   sudo cp deploy/nginx/grafana.conf.example /etc/nginx/sites-available/grafana.conf
#   sudo ln -s /etc/nginx/sites-available/grafana.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

# Зона под ограничение входа. Объявлена в http-контексте — файлы sites-enabled
# подключаются именно туда, поэтому директива стоит вне server-блока. Имя зоны
# уникально по всему конфигу nginx: второе объявление с тем же именем — ошибка
# старта.
#
# 10 попыток в минуту с адреса: живому человеку, промахнувшемуся паролем,
# этого не заметить, а перебор по словарю становится бессмысленным.
#
# КЛЮЧ ЗОНЫ ИМЕЕТ СМЫСЛ ТОЛЬКО ВМЕСТЕ С real_ip НИЖЕ. Шлюз проксирует HTTP, то
# есть все запросы приходят сюда с одного адреса; без подмены $remote_addr на
# настоящий адрес клиента лимит считался бы общим на весь интернет, и один
# перебор закрыл бы вход владельцу.
limit_req_zone $binary_remote_addr zone=grafana_login:1m rate=10r/m;

server {
    listen 41142;
    listen [::]:41142;

    # Имя одно: снаружи сюда приходят по root-hub.ru. На этом порту блок
    # единственный, поэтому он же и обработчик по умолчанию — в отличие от 80-го
    # порта здесь не с чем конфликтовать и `default_server` не нужен, а
    # неаккуратный шлюз, подставляющий свой Host, ничего не сломает.
    server_name root-hub.ru;

    # Настоящий адрес клиента вместо адреса шлюза: нужен и лимиту выше, и логам,
    # и Grafana, которая пишет адрес в свой журнал входов.
    #
    # Доверять X-Forwarded-For можно ровно потому, что попасть на этот порт
    # можно только через шлюз. Диапазон — локальная сеть плюс сам шлюз; если
    # ставить `set_real_ip_from 0.0.0.0/0`, любой клиент сможет подделать себе
    # адрес и обойти лимит.
    set_real_ip_from 192.168.100.0/24;
    set_real_ip_from 95.31.139.53;
    real_ip_header X-Forwarded-For;

    # Отдельный лог: попытки входа в Grafana из интернета должны быть видны, не
    # смешиваясь с обращениями к Mini App.
    access_log /var/log/nginx/grafana.access.log;

    # Дашборды отдают таблицы позиций целиком, и ответ бывает крупным; заодно
    # это потолок для импорта дашборда через интерфейс.
    client_max_body_size 10m;

    # Форма входа — единственное место, где пароль можно подобрать, поэтому
    # ограничение висит ровно на ней. Точное совпадение (`= /login`), чтобы под
    # лимит не попали дашборды: их листают быстро и помногу.
    #
    # burst=10 nodelay: подряд идущие попытки сверх лимита получают 503, но
    # небольшой всплеск (перезагрузка страницы, автозаполнение) проходит без
    # задержки.
    location = /login {
        limit_req zone=grafana_login burst=10 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Grafana Live: панели обновляются по WebSocket. Без Upgrade/Connection
    # nginx закрывает соединение как обычный HTTP-запрос, и это читается не как
    # ошибка, а как «дашборд почему-то не живой».
    #
    # Те же заголовки обязан передавать и шлюз — иначе соединение умрёт на нём,
    # не дойдя сюда.
    location /api/live/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Всё остальное. В proxy_pass намеренно нет пути после порта — так nginx
    # передаёт URI неизменным. Слэш в конце (`http://127.0.0.1:3000/`) обрезал
    # бы префикс и сломал бы вложенные пути Grafana.
    #
    # X-Forwarded-Proto ЗАДАН КОНСТАНТОЙ, а не $scheme, — и этим файл намеренно
    # отличается от mini_app.conf. $scheme здесь всегда `http`: TLS снят на
    # шлюзе. Для checks_service это безразлично, а Grafana по этому заголовку
    # решает, можно ли выставить куку с флагом Secure, — с `http` вход
    # зациклился бы на форме логина при включённом GF_SECURITY_COOKIE_SECURE.
    # Попасть на этот порт можно только через шлюз, а он всегда говорит с
    # клиентом по HTTPS, поэтому константа здесь не ложь, а единственная правда.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Тяжёлый SQL-запрос по позициям чеков за большой период не должен
        # обрываться раньше, чем Grafana успеет ответить.
        proxy_read_timeout 120s;
    }
}
