__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

env/*.env
secrets/
# Копия ключа сервисного аккаунта, оставшаяся от прежней раскладки. Compose
# монтирует secrets/google_sa.json, но файл в корне лежит рядом и в публичный
# репозиторий попасть не должен.
google-sa.json

# Переменные для подстановки в docker-compose.yml. Значения по умолчанию лежат
# в самом compose, а этот файл машинно-зависимый: адрес и порт у каждого свои.
.env
